{
  "expo": {
    "name": "AjudaAVC",
    "slug": "ajudavc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "ajudavc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/SplashLogo.png",
      "resizeMode": "cover", 
      "backgroundColor": "#73A5C6" 
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thomaaaa.ajudavc"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.thomaaaa.ajudavc"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.818045939260-fim8itj3ajsogffhlmpejkbvatsrc2b0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "797b3a10-03ed-4950-b4d3-911e69b58df6"
      }
    }
  }
}