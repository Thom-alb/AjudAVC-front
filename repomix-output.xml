          placeholderTextColor={colors.placeholder}
          autoCapitalize="none"
        />

        <Text style={styles.fieldLabel}>Nova senha</Text>
        <TextInput
          style={styles.input}
          value={newPassword}
          onChangeText={setNewPassword}
