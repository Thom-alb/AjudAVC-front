            <Text style={styles.modalButtonSecondaryText}>Cancelar</Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[styles.modalButton, styles.modalButtonPrimary]}
            onPress={savePassword}
            disabled={savingPassword}
          >
            {savingPassword ? (
              <ActivityIndicator color="#FFFFFF" />
            ) : (
              <Text style={styles.modalButtonPrimaryText}>Alterar</Text>
            )}
          </TouchableOpacity>
        </View>
      </FormModal>

      {/* Modal: Logs de Uso */}
      <FormModal
        visible={logsVisible}
        title="Meus logs de uso"
        onClose={() => setLogsVisible(false)}
        styles={styles}
      >
        {logsLoading ? (
          <ActivityIndicator color={colors.primary} style={{ marginVertical: 30 }} />
        ) : logsError ? (
          <Text style={styles.emptyText}>{logsError}</Text>
        ) : logs.length === 0 ? (
          <Text style={styles.emptyText}>Nenhuma atividade registrada até o momento.</Text>
        ) : (
          logs.map((item, index) => (
            <View
              key={String(item.id ?? index)}
              style={[styles.logItem, index < logs.length - 1 && styles.rowDivider]}
            >
              <Text style={styles.logAction}>
                {item.action || item.description || item.message || "Ação registrada"}
              </Text>
              <Text style={styles.logDate}>
                {formatLogDate(item.createdAt || item.timestamp || item.date)}
              </Text>
            </View>
          ))
        )}

        <TouchableOpacity
          style={[styles.modalButton, styles.modalButtonSecondary, { marginTop: 16 }]}
          onPress={() => setLogsVisible(false)}
        >
          <Text style={styles.modalButtonSecondaryText}>Fechar</Text>
        </TouchableOpacity>
      </FormModal>
    </SafeAreaView>
  );
}

// ---------------------------------------------------------------------------
// Componentes auxiliares
// ---------------------------------------------------------------------------
function Section({ title, children, styles }) {
  return (
    <View style={styles.section}>
      <Text style={styles.sectionTitle}>{title}</Text>
      <View style={styles.sectionCard}>{children}</View>
    </View>
  );
}

function Row({
  icon,
  label,
  subtitle,
  onPress,
  right,
  danger,
  dangerColor,
  disabled,
  last,
  styles,
  colors,
}) {
  const tint = danger ? dangerColor : colors.primary;
  const rightContent =
    right !== undefined ? (
      right
    ) : onPress ? (
      <Ionicons name="chevron-forward" size={20} color={colors.muted} />
    ) : null;

  return (
    <TouchableOpacity
      style={[styles.row, !last && styles.rowDivider]}
      onPress={onPress}
      disabled={!onPress || disabled}
      activeOpacity={onPress ? 0.7 : 1}
    >
      <View
        style={[
          styles.rowIcon,
          danger && { backgroundColor: "rgba(220, 38, 38, 0.12)" },
        ]}
      >
        <Ionicons name={icon} size={20} color={tint} />
      </View>
      <View style={styles.rowTexts}>
        <Text style={[styles.rowLabel, danger && { color: dangerColor }]}>{label}</Text>
        {!!subtitle && <Text style={styles.rowSubtitle}>{subtitle}</Text>}
      </View>
      {rightContent}
    </TouchableOpacity>
  );
}

function FormModal({ visible, title, onClose, children, styles }) {
  return (
    <Modal visible={visible} transparent animationType="fade" onRequestClose={onClose}>
      <KeyboardAvoidingView
        style={styles.modalOverlay}
        behavior={Platform.OS === "ios" ? "padding" : undefined}
      >
        <Pressable style={StyleSheet.absoluteFill} onPress={onClose} />
        <View style={styles.modalCard}>
          <Text style={styles.modalTitle}>{title}</Text>
          <ScrollView showsVerticalScrollIndicator={false} keyboardShouldPersistTaps="handled">
            {children}
          </ScrollView>
        </View>
      </KeyboardAvoidingView>
    </Modal>
  );
}

